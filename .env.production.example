# Copiar como .env.production, restringir sus permisos y sustituir todos los placeholders.
NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://REPLACE_WITH_PUBLIC_ORIGIN
LOG_LEVEL=info

# PostgreSQL interno. Las contraseñas incluidas en URLs deben estar percent-encoded.
POSTGRES_DB=red_huella
POSTGRES_USER=red_huella_migrator
POSTGRES_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
APP_DATABASE_PASSWORD=REPLACE_WITH_APP_PASSWORD
MIGRATION_DATABASE_URL=postgresql://red_huella_migrator:REPLACE_WITH_URL_ENCODED_MIGRATOR_PASSWORD@postgres:5432/red_huella
DATABASE_URL=postgresql://red_huella_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@postgres:5432/red_huella

IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_LOCAL_ROOT=/app/.data/uploads

# El artefacto se provisiona previamente en .data/models y se monta read-only.
VISUAL_MODEL_PATH=/app/.data/models/clip-vit-base-patch32-vision-quantized.onnx
VISUAL_EMBEDDING_PROCESSOR_ENABLED=true
VISUAL_EMBEDDING_POLL_INTERVAL_MS=30000
VISUAL_EMBEDDING_BATCH_SIZE=5

# Puerto HTTP local para un terminador TLS o smoke operativo en el mismo host.
WEB_HTTP_PORT=8080

