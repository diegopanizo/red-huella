# API runtime configuration
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# PostgreSQL 17 instalado localmente: sustituir USER/PASSWORD por credenciales locales; nunca versionar las reales.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/red_huella
DATABASE_TEST_URL=postgresql://USER:PASSWORD@localhost:5433/red_huella_test
# Alternativa Docker Compose development-only (host 5434, contenedor 5432):
# DATABASE_URL=postgresql://red_huella_app:red_huella_dev_only@localhost:5434/red_huella
# DATABASE_TEST_URL=postgresql://red_huella_app:red_huella_dev_only@localhost:5434/red_huella_test
LOG_LEVEL=info
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_LOCAL_ROOT=.data/uploads
# El nombre, TTL de sesión y parámetros Argon2 son constantes internas revisadas en código.
