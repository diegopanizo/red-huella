# API runtime configuration
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# En producción se exige un origen HTTPS exacto, sin path ni barra final.
# PostgreSQL 17 instalado localmente: sustituir USER/PASSWORD por credenciales locales; nunca versionar las reales.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/red_huella
DATABASE_TEST_URL=postgresql://USER:PASSWORD@localhost:5433/red_huella_test
# Playwright crea/aplica migraciones y limpia solo una base cuyo nombre termina en _e2e.
DATABASE_E2E_URL=postgresql://USER:PASSWORD@localhost:5433/red_huella_e2e
# Alternativa Docker Compose development-only (host 5434, contenedor 5432):
# DATABASE_URL=postgresql://red_huella_app:red_huella_dev_only@localhost:5434/red_huella
# DATABASE_TEST_URL=postgresql://red_huella_app:red_huella_dev_only@localhost:5434/red_huella_test
LOG_LEVEL=info
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_LOCAL_ROOT=.data/uploads
VISUAL_MODEL_PATH=.data/models/clip-vit-base-patch32-vision-quantized.onnx
VISUAL_MODEL_ID=Xenova/clip-vit-base-patch32
VISUAL_MODEL_VERSION=6ef1ebc8b0766a7a8d11b146462c99cdf74dd22d
VISUAL_EMBEDDING_PROCESSOR_ENABLED=false
VISUAL_EMBEDDING_POLL_INTERVAL_MS=30000
VISUAL_EMBEDDING_BATCH_SIZE=5
# El nombre, TTL de sesión y parámetros Argon2 son constantes internas revisadas en código.
# Para Docker Compose de producción usar .env.production.example; no reutilizar
# credenciales, hosts ni orígenes de esta plantilla de desarrollo.
